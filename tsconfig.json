{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "hooks",
    "types",
    "tests",
    ".claude-plugin/types"
  ]
}
